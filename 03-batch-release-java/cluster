#!/usr/bin/env bash
# Start, inspect and stop the batch-release chain for this example.
#
#   ./cluster start 3 --anchor-mode metadata   three members + Cardano anchoring
#   ./cluster status                           tips, roots, anchor state
#   ./cluster stop | clean
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd -P)"

export EXAMPLE_HTTP_BASE="${EXAMPLE_HTTP_BASE:-7130}"
export EXAMPLE_SERVER_BASE="${EXAMPLE_SERVER_BASE:-13430}"

. "$HERE/../00-shared/lib/example-cluster.sh"
example_cluster "$HERE" "$@"
