#!/usr/bin/env bash
# Start, inspect and stop the release chain for this example.
#
#   ./cluster start 3   three members; only member 0 runs the webhook executor
#
# Effects have two halves with different scopes:
#
#   consensus-shared  "reaching approval emits an effect"   -> chain/release-approvals.template.yaml
#   node-local        "and I am the one who performs it"    -> written below
#
# Node-local settings go in each member's own config/local.yaml, which the setup
# tool never rewrites and which may not change a sealed setting. Writing it here
# keeps the split visible: only node0 is told the endpoint, so exactly one
# member calls it.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd -P)"

export EXAMPLE_HTTP_BASE="${EXAMPLE_HTTP_BASE:-7160}"
export EXAMPLE_SERVER_BASE="${EXAMPLE_SERVER_BASE:-13460}"
RECEIVER_URL="${RECEIVER_URL:-http://127.0.0.1:8160/erp/release}"

# node0 executes effects. The others only agree that they happened.
example_local_config() {
  local n="$1" node="$2" index
  [ "$n" = 0 ] || return 0
  # join numbers each chain once, in join order; local settings address it as chains[<i>].
  index="$(jq -r '."release-chain"' "$node/apps/chain-indexes.json")"
  cat > "$node/config/local.yaml" <<EOF
# node0's own settings, written by ./cluster. Settings here win over
# config/node.yaml; sealed consensus settings cannot be changed here.
#
# This member, and only this one, performs release-chain's webhook effects.
yano:
  app-chain:
    "chains[$index]":
      effects:
        executor:
          enabled: true
          types: webhook.post
        executors:
          webhook:
            url: $RECEIVER_URL
            timeout-ms: 5000
EOF
  chmod 600 "$node/config/local.yaml"
}

. "$HERE/../00-shared/lib/example-cluster.sh"
example_cluster "$HERE" "$@"
