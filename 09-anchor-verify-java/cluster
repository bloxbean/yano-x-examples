#!/usr/bin/env bash
# Start, inspect and stop the evidence chain for this example.
#
#   ./cluster start 3     three members on a private devnet (HTTP 7150..7152),
#                         the chain anchored to Cardano in script mode
#   ./cluster status      per-node tip, state root and cross-node consistency
#   ./cluster logs 0 -f   tail a node log
#   ./cluster stop        stop the nodes, keep the data
#   ./cluster clean       stop and wipe .yano/
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd -P)"
export EXAMPLE_HTTP_BASE="${EXAMPLE_HTTP_BASE:-7150}"
export EXAMPLE_SERVER_BASE="${EXAMPLE_SERVER_BASE:-13450}"
. "$HERE/../00-shared/lib/example-cluster.sh"
example_cluster "$HERE" "$@"
