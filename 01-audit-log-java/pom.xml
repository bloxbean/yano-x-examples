<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bloxbean.yano.examples</groupId>
  <artifactId>audit-log</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Yano X example 01 — shared access-change audit log</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Keep in step with the extracted yano-x-jvm-<version> distribution. -->
    <yano.x.version>0.1.0-pre2</yano.x.version>
    <!-- The Yano runtime version that Yano X release is built on. -->
    <yano.version>0.1.0-pre15</yano.version>
    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        The app-chain testkit pulls in junit-jupiter-api 5.8.1 at compile scope.
        Without this BOM it wins over a newer engine and every test run fails
        with "TestEngine with ID 'junit-jupiter' failed to discover tests".
      -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The Yano X app-chain client. It pulls in yano-core-api, the app-chain
      proof verifier and the MPF implementation transitively.
    -->
    <dependency>
      <groupId>org.yanoproject.x</groupId>
      <artifactId>yano-x-client</artifactId>
      <version>${yano.x.version}</version>
    </dependency>

    <!--
      Jackson is already on the runtime classpath via yano-x-client; this
      example reads it back at compile time only to decode its own event
      bodies. A real application would use whatever JSON library it prefers —
      the chain stores opaque bytes and does not care.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.21.4</version>
    </dependency>

    <!-- Quiet the SLF4J "no provider" warning on startup. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.18</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      The app-chain testkit runs a real multi-member chain inside the test JVM:
      no devnet, no ports, no ./cluster start. It is what lets the tests assert
      the claims DEMO.md makes, in seconds, in CI.
    -->
    <dependency>
      <groupId>org.yanoproject</groupId>
      <artifactId>yano-appchain-core-testkit</artifactId>
      <version>${yano.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>audit-log</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- One runnable jar so demo.sh can just `java -jar target/audit-log.jar`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.bloxbean.yano.examples.auditlog.AuditLogApp</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
