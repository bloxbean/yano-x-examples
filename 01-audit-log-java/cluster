#!/usr/bin/env bash
# Start, inspect and stop the three-member access-log chain for this example.
# It seals chain/access-log.template.yaml with the release's own setup commands
# (see ../00-shared/README.md).
#
#   ./cluster start 3     three members on a private devnet (HTTP 7100..7102)
#   ./cluster status      the application's stage, every member's tip and root
#   ./cluster logs 0 -f   tail a member's log
#   ./cluster stop [n]    stop the members (or just member n), keep the data
#   ./cluster clean       stop and wipe .yano/ (chain, member keys, devnet)
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd -P)"

# Distinct ports per example so several can run side by side.
export EXAMPLE_HTTP_BASE="${EXAMPLE_HTTP_BASE:-7100}"
export EXAMPLE_SERVER_BASE="${EXAMPLE_SERVER_BASE:-13400}"

. "$HERE/../00-shared/lib/example-cluster.sh"
example_cluster "$HERE" "$@"
