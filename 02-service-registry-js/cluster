#!/usr/bin/env bash
# Start, inspect and stop the three-member service registry for this example.
#
#   ./cluster start 3     three members on a private devnet (HTTP 7110..7112)
#   ./cluster status      per-member tip, state root and cross-member agreement
#   ./cluster stop        stop the members, keep the data
#   ./cluster clean       stop and wipe .yano/
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd -P)"

export EXAMPLE_HTTP_BASE="${EXAMPLE_HTTP_BASE:-7110}"
export EXAMPLE_SERVER_BASE="${EXAMPLE_SERVER_BASE:-13410}"

. "$HERE/../00-shared/lib/example-cluster.sh"
example_cluster "$HERE" "$@"
